# ============================================================
# API provider – choose ONE of the two options below
# ============================================================

# --- Option A: OpenRouter (recommended if you use openrouter.ai) ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# Base URL is set automatically when OPENROUTER_API_KEY is present.
# You can still override it:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Chat model on OpenRouter (examples):
#   openai/gpt-4o-mini
#   openai/gpt-4o
#   anthropic/claude-3.5-sonnet
#   google/gemini-flash-1.5
#   meta-llama/llama-3.1-70b-instruct
OPENAI_MODEL=openai/gpt-4o-mini

# Embedding model on OpenRouter (must support embeddings):
#   openai/text-embedding-3-small
#   openai/text-embedding-3-large
EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional OpenRouter headers (shown on openrouter.ai rankings)
# OPENROUTER_SITE_URL=https://github.com/your-username/lab4-product-research-assistant
# OPENROUTER_APP_NAME=Lab4-Product-Research-Assistant

# --- Option B: Official OpenAI ---
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# Optional: LangSmith tracing
# ============================================================
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-api-key-here
# LANGCHAIN_PROJECT=lab4-product-research-assistant